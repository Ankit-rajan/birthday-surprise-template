# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database (MongoDB Atlas connection string) ----
MONGODB_URI=mongodb://127.0.0.1:27017/birthday-surprise

# ---- Frontend origin(s), comma-separated, no trailing slash ----
# Local:      http://localhost:5173
# Production: https://your-site.vercel.app
FRONTEND_URL=http://localhost:5173

# ---- Reverse proxies ----
# Production traffic goes Browser -> Vercel (rewrite) -> Render, so 2 proxies. Local dev: 0.
TRUST_PROXY=0

# ---- Cookies ----
# 'strict' works because Vercel proxies /api to this server (same-origin for the browser).
# Only use 'none' if you call the API cross-site (not recommended; Safari blocks it).
COOKIE_SAMESITE=strict
# Defaults to true in production, false otherwise.
# COOKIE_SECURE=true

# ---- Session lifetimes ----
VAULT_IDLE_SECONDS=180
VAULT_MAX_MINUTES=60
ADMIN_IDLE_MINUTES=30
ADMIN_MAX_HOURS=8

# ---- Journal encryption (AES-256-GCM) ----
# Generate with:  openssl rand -base64 32
# KEEP A BACKUP. If you lose this key, saved journal entries cannot be read.
JOURNAL_ENCRYPTION_KEY=

# ---- Seed script only (npm run seed). Never commit real values. ----
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
VAULT_PASSWORD=
