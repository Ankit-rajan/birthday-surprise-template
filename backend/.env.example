# =====================================================================
#  Backend environment variables.  Copy to backend/.env for local work.
#  On Render, set the same names under  Environment  (never commit real values).
# =====================================================================

# ---- Server ----
NODE_ENV=development            # Render: production
PORT=5000                       # Render sets this itself

# ---- Database (MongoDB Atlas connection string) ----
MONGODB_URI=mongodb://127.0.0.1:27017/birthday-surprise

# ---- Frontend origin(s), comma-separated, no trailing slash ----
# Used for the Origin/CSRF check and for password-reset links.
# Local:      http://localhost:5173
# Production: https://your-site.vercel.app   (add your custom domain too, comma-separated)
FRONTEND_URL=http://localhost:5173
# Optional: the public address used in password-reset emails. Defaults to the first FRONTEND_URL.
# APP_URL=https://your-site.vercel.app

# ---- Reverse proxies ----
# Production traffic goes Browser -> Vercel (rewrite) -> Render, so 2 proxies. Local dev: 0.
TRUST_PROXY=0                   # Render: 2

# ---- Cookies ----
# 'strict' works because Vercel proxies /api to this server (same-origin for the browser).
COOKIE_SAMESITE=strict
# Defaults to true in production, false otherwise.
# COOKIE_SECURE=true

# ---- Session lifetimes ----
USER_IDLE_DAYS=14               # customers: signed out after this long without activity
USER_MAX_DAYS=30                # customers: hard limit, also the "keep me signed in" cookie lifetime
ADMIN_IDLE_MINUTES=30           # platform owner
ADMIN_MAX_HOURS=8
VAULT_IDLE_SECONDS=180          # visitors inside a private vault
VAULT_MAX_MINUTES=60

# ---- Sign-ups and storage ----
REGISTRATION_OPEN=true          # set false to stop new accounts (existing customers keep working)
# Per-customer upload quota in MB (photos + videos + music, including private ones).
# MongoDB Atlas FREE tier is 512 MB in total: 100 users x 100 MB will not fit. See docs/MULTI_USER_PLATFORM.md.
MAX_USER_STORAGE_MB=100

# ---- Journal encryption (AES-256-GCM) ----
# Generate with:  openssl rand -base64 32
# KEEP A BACKUP. If you lose this key, saved journal entries cannot be read.
JOURNAL_ENCRYPTION_KEY=

# ---- Password-reset email (optional) ----
# Without SMTP_URL, reset links are printed to the server console in development ONLY and are never delivered
# in production, so customers cannot reset their own password. Any SMTP provider works, e.g.
#   smtps://username:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM="Surprise Studio <no-reply@yourdomain.com>"

# ---- Platform-owner account (npm run seed). Never commit real values. ----
# This is YOU as the owner of the service. It is NOT a customer account and has no birthday website.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=
