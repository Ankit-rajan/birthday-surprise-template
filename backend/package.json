    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "mongoose": "^8.5.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  }
