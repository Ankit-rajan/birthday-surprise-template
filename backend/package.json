{
  "name": "birthday-surprise-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API for A Little World Made For You",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js",
