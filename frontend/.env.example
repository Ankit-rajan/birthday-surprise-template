# Leave EMPTY in normal use: the app calls /api on its own origin
# (Vite proxy in development, Vercel rewrite in production).
# Only set this if you deliberately host the API on a different domain.
VITE_API_BASE=

# Development only: where the Vite dev server forwards /api
VITE_DEV_API=http://localhost:5000

# ---- Marketing footer (all optional; links you leave empty are simply not shown) ----
VITE_CONTACT_EMAIL=
VITE_INSTAGRAM_URL=
VITE_YOUTUBE_URL=
VITE_X_URL=
VITE_GITHUB_URL=
